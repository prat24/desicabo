# Example systemd unit for the relay — goes in /etc/systemd/system/.
# Adjust the two paths below to where you put relay.py and its settings.
#
# The relay runs as a throwaway user that exists only while it runs, can write
# nothing at all, and can talk to nothing but loopback (the web server). Check
# the sandbox with:  systemd-analyze security desicabo-relay

[Unit]
Description=Desi Cabo WebSocket relay
After=network.target

[Service]
Type=simple
EnvironmentFile=/etc/desicabo/relay.env
ExecStart=/usr/bin/python3 -I /opt/desicabo/relay.py
Restart=on-failure
RestartSec=2
TimeoutStopSec=15

DynamicUser=yes
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateUsers=yes
PrivateIPC=yes
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RemoveIPC=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
IPAddressDeny=any
IPAddressAllow=localhost
DevicePolicy=closed

MemoryMax=128M
TasksMax=16
LimitNOFILE=256

[Install]
WantedBy=multi-user.target
