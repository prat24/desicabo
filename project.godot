; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Desi Cabo"
run/main_scene="res://Scenes/UI/main_menu.tscn"
config/features=PackedStringArray("4.7", "Mobile")
boot_splash/bg_color=Color(0.043, 0.068, 0.09, 1)
boot_splash/show_image=false
boot_splash/image="res://splashicon.png"
config/icon="uid://ccaudtqcbolm7"

[autoload]

AudioSettings="*res://Scripts/Audio/audio_settings.gd"
Music="*res://Scripts/Audio/music_player.gd"
HoverSfx="*res://Scripts/Audio/hover_sfx.gd"
Net="*res://Scripts/Net/net_manager.gd"

[display]

window/size/viewport_width=1080
window/size/viewport_height=1920
window/stretch/mode="viewport"
window/stretch/aspect="expand"
window/handheld/orientation=1

[input_devices]

pointing/emulate_touch_from_mouse=true

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0, 0, 0, 1)

[shader_globals]

mouse_screen_pos={
"type": "vec2",
"value": Vector2(0, 0)
}
